# Copie ce fichier en .env et remplis-le TOI-MÊME (jamais dans un chat, jamais commité).
# Windows : le script installation/installer_windows.ps1 restreint .env à ton compte (équivalent chmod 600).

# --- Telegram (voir README : @BotFather puis getUpdates) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Identifiants (utilisés seulement si la session du navigateur a expiré) ---
ALJT_EMAIL=
ALJT_PASSWORD=
PARIS_LOGIN=
PARIS_PASSWORD=
AL_EMAIL=
AL_PASSWORD=

# --- Plateformes actives (1/0) ---
ALJT_ACTIF=1
PARIS_ACTIF=1
AL_ACTIF=1

# --- PRODUCTION : 0 = dry-run (rien n'est envoyé). Ne passer à 1 qu'après validation du mode test. ---
ALJT_PRODUCTION=0
PARIS_PRODUCTION=0
# Action Logement : candidature auto en gardant 1 place libre (candidatures NON annulables)
AL_PRODUCTION=0

# --- Intervalles de lecture en secondes (±20 % aléatoire) ---
ALJT_INTERVALLE=300
PARIS_INTERVALLE=300
AL_INTERVALLE=300

# --- Garde-fous / alertes ---
SEUIL_ANOMALIE=15
AL_RELANCE_SECONDES=120
AL_RELANCES_MAX=10

# --- Motif LOC'Annonces : Ollama local (modèle de secours sinon) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELE=qwen2.5:7b-instruct
LLM_TIMEOUT=40
PARIS_MOTIF_MAX=1000

# --- Navigateur ---
HEADLESS=1
NAVIGATEUR_CANAL=chrome

# Action Logement : Cloudflare bloque Chrome headless -> vraie fenêtre réduite (0)
AL_HEADLESS=0
ALJT_HEADLESS=1
PARIS_HEADLESS=1

# Garder le PC éveillé sur secteur (1) ou le laisser dormir avec réveils toutes les 10 min (0)
GARDER_EVEIL=0
